# Frontend build-time configuration. Holds no secret: everything here is
# compiled into the public bundle. Copy to `frontend/.env` only if you need to
# change the default.

# API prefix. Optional; defaults to /api when unset.
#
# Must be same-origin. The session cookie is host-only with SameSite=Strict
# and the backend enables no CORS, so an absolute URL on another host or port
# (for example http://localhost:3000/api while the app runs on :5173) cannot
# authenticate: the browser blocks the request and never sends the cookie.
# Keep the relative prefix and let the reverse proxy forward it — Vite proxies
# /api to 127.0.0.1:3000 in development, Nginx proxies it in production.
#
# Startup validation rejects a cross-origin value with an explanation.
VITE_API_URL=/api
