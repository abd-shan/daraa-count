# Root Compose environment. Copy to .env and replace the placeholders.
# Never commit the real file: it is covered by .gitignore.

# Database password. Generate a long random value, for example:
#   openssl rand -hex 32
# Changing this on an already-initialised volume does NOT change the password
# in PostgreSQL; alter the role instead.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_DATABASE_PASSWORD

# The public HTTPS origin the browser actually opens. The backend rejects any
# unsafe request whose Origin header does not match this exactly, so a
# mismatch shows up as a 403 on login. No trailing slash.
APP_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN

# Session and import limits.
SESSION_COOKIE_NAME=count_daraa_session
SESSION_TTL_HOURS=12
MAX_IMPORT_FILE_MB=10
MAX_IMPORT_ROWS=10000

# Published loopback ports. The host proxy forwards HTTPS to WEB_PORT; DB_PORT
# exists for psql, pg_dump and the backup script. Neither is public.
WEB_PORT=8080
DB_PORT=5432

# Baked into the frontend bundle at image build time. Must stay same-origin:
# the session cookie is host-only and the backend enables no CORS.
VITE_API_URL=/api

# Image tag for all three images; set a release identifier in production.
COUNT_DARAA_IMAGE_TAG=local
